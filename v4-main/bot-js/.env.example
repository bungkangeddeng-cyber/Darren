# ============================================================
# Konfigurasi Bot Telegram Aji / RIPZZ STORE (@Notif2Ajibot)
# Copy file ini menjadi .env lalu isi nilainya
# ============================================================

# Token bot dari @BotFather (WAJIB)
BOT_TOKEN=

# Telegram user ID admin (Aji)
ADMIN_ID=

# --- VPN Server API ---
# Bot memanggil API di server VPN untuk create/renew/delete akun
# (sesuaikan dengan API yang ada di server, misal port 5890)
VPN_API_BASE=http://127.0.0.1:5890
VPN_API_AUTH=

# Domain utama server VPN
VPN_DOMAIN=

# --- CloudFront ---
# Domain CloudFront untuk mode CF (VMess/VLess/Trojan/SSH via CF)
CF_DOMAIN=
CF_VMESS_UUID=
CF_VLESS_UUID=
CF_TROJAN_PASSWORD=

# --- PPOB / Digiflazz ---
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API_KEY=
# Harga jual = harga modal + margin (default 0)
PPOB_MARGIN=0

# --- QRIS H2H Gateway (deposit saldo + sewa) ---
# Gateway GoPay milik sendiri (H2H). Kunci = kunci tenant gk_ milik OPERATOR
# bot (bukan kunci tenant lain). JANGAN commit kunci asli ke repo; isi di
# .env server saat deploy. QRIS H2H berlaku 5 menit.
H2H_BASE_URL=https://payment-gateway.outletku.ai.id/api/h2h/v1
H2H_API_KEY=

# --- DEPRECATED: QRIS P2P Gateway (tidak dipakai lagi sejak rombak H2H) ---
# P2P_GATEWAY_URL=
# P2P_API_KEY=

# --- Sidompul (cek kuota) ---
SIDOMPUL_API_KEY=

# --- Registrasi IP Lisensi Script (GitHub) ---
# Setelah pembayaran sewa lunas, bot menulis lisensi IP ke file
# "ip" di repo GitHub pemilik lewat API. Token diisi PEMILIK di
# server bot (JANGAN commit token asli ke repo).
# Buat token: GitHub > Settings > Developer settings >
# Personal access tokens (classic), scope: repo
GH_IP_TOKEN=
GH_IP_OWNER=
GH_IP_REPO=
GH_IP_FILE=
GH_IP_BRANCH=main
